# Copy to .env for local Docker Compose use. Do not commit the real .env.
DB_NAME=bankcards
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Secrets — generate your own, never reuse these placeholders.
#
#   JWT_SECRET             openssl rand -base64 48
#   CARD_ENCRYPTION_SECRET openssl rand -base64 48
#   ADMIN_PASSWORD         openssl rand -base64 24
#
# JWT_SECRET must be at least 32 bytes; HS256 signing rejects shorter keys.
# Changing CARD_ENCRYPTION_SECRET makes existing encrypted card numbers
# undecryptable — re-key deliberately, not by accident.
JWT_SECRET=replace-me-with-openssl-rand-base64-48
CARD_ENCRYPTION_SECRET=replace-me-with-openssl-rand-base64-48
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me-with-openssl-rand-base64-24
